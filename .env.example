# Bu dosyayı `.env` olarak kopyalayıp ihtiyacına göre düzenle
# `docker compose up` bu dosyayı otomatik okur (env_file: .env)

APP_HOST=0.0.0.0
APP_PORT=5000
APP_SERVER=waitress
# FLASK_DEBUG yalnızca APP_SERVER=flask iken etkilidir
FLASK_DEBUG=0

APP_CORS_ALLOW_ORIGIN=*

APP_RATE_LIMIT_WINDOW_SECONDS=60
APP_RATE_LIMIT_MAX_REQUESTS=60
APP_MAP_GEOJSON_RATE_LIMIT_MAX_REQUESTS=10
APP_RATE_LIMIT_MAX_TRACKED_IPS=50000
APP_TOPLU_MAX_SORGU=20

MGM_TIMEOUT=10
MGM_RETRY_TOTAL=3
MGM_RETRY_BACKOFF=0.3

MGM_CACHE_TTL=60
MGM_CACHE_MAX_ENTRIES=512
MGM_STALE_WHILE_REVALIDATE=300

MGM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
MGM_CIRCUIT_BREAKER_WINDOW_SECONDS=30
MGM_CIRCUIT_BREAKER_OPEN_SECONDS=60

# guncel_durum için saat başına göre dinamik TTL MGM'nin ölçümleri 
# genelde saat başından birkaç dakika sonra düşer resmi garanti değildir. 0'la kapatılabilir
MGM_GUNCEL_DINAMIK_TTL=1
MGM_GUNCEL_SICAK_PENCERE_BASLANGIC_DK=5
MGM_GUNCEL_SICAK_PENCERE_BITIS_DK=15
MGM_GUNCEL_SICAK_TTL_SANIYE=120
MGM_GUNCEL_SOGUK_TTL_SANIYE=1800
MGM_GUNCEL_GECE_BASLANGIC_SAAT=0
MGM_GUNCEL_GECE_BITIS_SAAT=6
MGM_GUNCEL_GECE_TTL_SANIYE=3600
# guncel_durum'dan bağımsız: tahmin günde birkaç kez güncellenir.
MGM_TAHMIN_TTL_SANIYE=10800

# ibb kirletici konsantrasyonları saatlik güncellenir
MGM_HAVA_KALITESI_TTL_SANIYE=600
# ibb istasyon listesi (id/isim/konum)
MGM_IBB_ISTASYON_TTL_SANIYE=21600
# en yakın İBB istasyonu bu mesafeden uzaksa Open-Meteoya düşer
MGM_IBB_MAX_MESAFE_KM=40

# /map/geojson — il sınırları statik veri olduğundan çok uzun TTL kullanılır
MGM_GEOJSON_SINIR_TTL_SANIYE=2592000
# Aynı uç noktadaki il başına anlık sıcaklık, guncel_durum'la aynı
# tazelikte kalsın diye ayrı ve kısa tutulur
MGM_HARITA_SICAKLIK_TTL_SANIYE=600
# Deniz durumu (dalga/SST) hava sıcaklığından daha yavaş değişir
MGM_DENIZ_TTL_SANIYE=1800
# Piri Reis SSR sayfası aynı istekte tüm istasyonları döndürür, bu TTL
# ile birlikte cachelenir (birinci kaynak)
MGM_PIRI_REIS_TTL_SANIYE=1800
# En yakın Piri Reis istasyonu bu mesafeden uzaksa Open-Meteo'ya düşer
MGM_PIRI_REIS_MAX_MESAFE_KM=60

# docker-compose.yml bunu otomatik olarak bundled `redis` servisine
# ayarlar (redis://redis:6379/0). Redis'i tamamen kapatmak için
# boş bırakın sonra uygulama in-memory cache'e döner
MGM_REDIS_URL=redis://redis:6379/0
MGM_REDIS_PREFIX=mgm-cache:
